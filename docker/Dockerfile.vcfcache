FROM python:3.13-slim-trixie AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV VCFCACHE_ROOT=/app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bcftools \
      tabix \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY vcfcache ./vcfcache
COPY resources ./resources

# Runtime env: lean install (no tests needed here)
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install .

ENV PATH="/opt/venv/bin:${PATH}"

########## Test stage (optional, dev deps only in this stage) ##########
FROM base AS test
COPY tests ./tests
# Part of the suite exercises the benchmark drivers, so the modules they import
# must be present. Copy source and the explicitly needed small fixture tables,
# not the full benchmark archives or rendered figures.
COPY benchmarks/*.py ./benchmarks/
COPY benchmarks/fastvep_pilot/*.py ./benchmarks/fastvep_pilot/
COPY benchmarks/branch_eval/*.py ./benchmarks/branch_eval/
COPY benchmarks/engine_profile/*.py ./benchmarks/engine_profile/
COPY benchmarks/performance_sprint/*.py ./benchmarks/performance_sprint/
# Several tests assert that tracked manifests stay in step with the runner
# allow-lists, so those small tables are needed too.
COPY benchmarks/manifests ./benchmarks/manifests
COPY benchmarks/config ./benchmarks/config
COPY benchmarks/*.sh ./benchmarks/
# Frozen source tables only (1 MB). benchmarks/figures/output holds ~78 MB of
# rendered figures that no test reads.
COPY benchmarks/figures/source_data ./benchmarks/figures/source_data
# The sprint inventory tests verify all manuscript families against their real
# small tables. Keep these fixtures explicit; never copy the multi-GB archives.
COPY benchmarks/figures/output/final/2026-08-25T224623Z-native-annotation-final-v3/source/campaign_metrics.tsv \
     benchmarks/figures/output/final/2026-08-25T224623Z-native-annotation-final-v3/source/external_assay_v3_metrics.tsv \
     benchmarks/figures/output/final/2026-08-25T224623Z-native-annotation-final-v3/source/dual_cache_pipeline_spectrum.tsv \
     ./benchmarks/figures/output/final/2026-08-25T224623Z-native-annotation-final-v3/source/
COPY benchmarks/results/raw/campaigns/external-vep-light-full52-bbef41d7db8e/manifests/measured.tsv ./benchmarks/results/raw/campaigns/external-vep-light-full52-bbef41d7db8e/manifests/
COPY benchmarks/results/raw/campaigns/external-fastvep-2cd2ab56d8ee-light-strict-v2/manifests/measured.tsv ./benchmarks/results/raw/campaigns/external-fastvep-2cd2ab56d8ee-light-strict-v2/manifests/
COPY benchmarks/results/raw/campaigns/external-assay-v3-independent-af001-warm/manifests/benchmark_tasks.tsv ./benchmarks/results/raw/campaigns/external-assay-v3-independent-af001-warm/manifests/
COPY benchmarks/results/raw/campaigns/wgs-pipeline-spectrum-4f854e5-kpgp00319/manifests/tasks.tsv ./benchmarks/results/raw/campaigns/wgs-pipeline-spectrum-4f854e5-kpgp00319/manifests/
COPY benchmarks/results/raw/campaigns/wgs-pipeline-spectrum-af001-cd87186-kpgp00319/manifests/tasks.tsv ./benchmarks/results/raw/campaigns/wgs-pipeline-spectrum-af001-cd87186-kpgp00319/manifests/
COPY benchmarks/reproduction/final_clinical_campaign/blocksort.frozen.awk ./benchmarks/reproduction/final_clinical_campaign/
# One provenance test shells out to git; it is needed for tests, not at runtime.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/pip install ".[dev]"
# The benchmark runners record the commit they ran from, so the tests covering
# that provenance need /app to be a git work tree. The real history is
# deliberately not copied into the image, so a stub repository stands in; the
# tests assert the recording behaviour, not the commit value.
RUN git init -q /app && \
    git -C /app config user.email ci@example.invalid && \
    git -C /app config user.name CI && \
    git -C /app commit -q --allow-empty -m "container test stub"
CMD ["/opt/venv/bin/python", "-m", "pytest", "tests", "-q"]

########## Optional native prototype (normal images remain Rust-free) ##########
FROM rust:1-bookworm AS native-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config zlib1g-dev libclang-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /native
COPY native/Cargo.toml native/Cargo.lock ./
COPY native/src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --locked

FROM base AS native-final
COPY --from=native-build /native/target/release/vcfcache-engine /usr/local/bin/
ENTRYPOINT ["vcfcache"]
CMD ["--help"]

FROM test AS native-test
COPY --from=native-build /native/target/release/vcfcache-engine /usr/local/bin/
CMD ["/opt/venv/bin/python", "-m", "pytest", "tests/test_fused_engine.py", "tests/test_native_engine.py", "-q"]

########## Final minimal image (still the default final stage) ##########
FROM base AS final
ENTRYPOINT ["vcfcache"]
CMD ["--help"]
